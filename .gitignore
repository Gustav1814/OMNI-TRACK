# ============================================================
# OmniTrack AI — Git Ignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
.venv312/
*.egg-info/
dist/
build/

# Node / Frontend
node_modules/
frontend/dist/
frontend/build/
.vite/

# Environment
.env
.env.local
.env.*.local
.venv/
.venv311

# AI Models — ignore by default; ship defaults under backend/model_weight for clone-and-run
*.pt
*.pth
*.onnx
*.engine
*.weights
!backend/model_weight/
!backend/model_weight/**/*

# IDE / Editor
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Project proposal — kept locally, not in version control
/FYP-I-Proposal-OmniTrack-Template.docx

# Exports & storage
exports/
backend/storage/
# Job artifacts (snapshot crops + annotated clips) — generated at runtime.
# VisRax commits these; 19k files is not something to copy.
backend/shared/

# Alembic migrations (keep in repo for clone-and-run)

# Docker
docker-compose.override.yml

# Misc
*.bak
*.tmp
.cache/

# Local dev / editor junk
backend/local.db
**/~$*
*.mp4

# Benchmark artefacts: keep the JSON/markdown results, not the generated video
backend/benchmarks/results/*.mp4

# Local uvicorn logs from detached runs
backend/uvicorn_out.log
backend/uvicorn_err.log
