# ============================================================
# OmniTrack AI — Environment Configuration
# ============================================================

# SECRETS: do not fill these by hand. Run
#   python scripts/generate_secrets.py --rotate-db-password --docker-context desktop-linux
# which writes strong random values into backend/.env (gitignored, mode 600) and
# rotates the Postgres password. The backend REFUSES TO START when any secret is
# empty, a known placeholder, or shorter than 32 bytes (app/security/secrets_check.py).

# --- Database --- (password is replaced by generate_secrets.py)
DATABASE_URL=postgresql+asyncpg://omnitrack:@localhost:5432/omnitrack_db
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_RUN_MIGRATIONS_ON_STARTUP=true
DB_RUN_ANALYZE_ON_STARTUP=true
DB_RETENTION_ON_STARTUP=true
DB_CREATE_FUTURE_PARTITIONS_ON_STARTUP=true
DB_PARTITION_MONTHS_AHEAD=3
DETECTION_RETENTION_DAYS=30
EMBEDDING_RETENTION_DAYS=90
ANALYTICS_RETENTION_DAYS=365
# Alert evidence (snapshot + clip per alert/fire, encrypted at rest under EVIDENCE_DIR)
EVIDENCE_ENABLED=true
EVIDENCE_DIR=storage/evidence
EVIDENCE_RETENTION_DAYS=30
EVIDENCE_MAX_GB=5
EVIDENCE_PRE_S=4
EVIDENCE_POST_S=5
# Per-camera pre-roll ring the evidence clips are cut from (JPEG, downscaled, shared RAM budget)
EVIDENCE_RING_FPS=8
EVIDENCE_RING_MAX_WIDTH=960
EVIDENCE_RING_TOTAL_MB=150
REID_GALLERY_WARM_LIMIT=2000
DB_STARTUP_MAX_RETRIES=30
DB_STARTUP_RETRY_SECONDS=2
REDIS_STARTUP_MAX_RETRIES=15
REQUIRE_DATABASE=true
REQUIRE_REDIS=true

# --- Auth (JWT access 15 min + rotating refresh 7 days) ---
JWT_SECRET_KEY=
ADMIN_SESSION_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FIRST_USER_ADMIN=true
ALLOW_PUBLIC_REGISTRATION=false
ENFORCE_SECRET_STRENGTH=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Reverse proxies whose X-Forwarded-For is trusted (rate limit / audit use the real client IP)
TRUSTED_PROXIES=[]

# --- AES-256-GCM encryption at rest (crops, snapshots, audit metadata) ---
# Changing it makes previously encrypted data unreadable.
AES_SECRET_KEY=

# --- Audit chain (HMAC-SHA256; verified at startup and every N hours) ---
# Changing it makes existing audit entries fail verification.
AUDIT_HMAC_KEY=
AUDIT_VERIFY_INTERVAL_HOURS=24

# --- Input safety ---
# http(s) camera sources must match one of these hosts/CIDRs (rtsp is always allowed;
# file sources must live under VIDEO_SOURCE_DIRS)
CAMERA_SOURCE_ALLOWLIST=[]
ALLOW_WEBCAM_SOURCES=true

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AI Models ---
# Person detector chosen per device (CAVIAR eval: yolo11s@640 AP50 .846, 146 ms/frame CPU).
# PERSON_MODEL=<file> forces one model. DETECTOR_EXPORT: auto (CPU: openvino>onnx, 2.1x faster
# than PyTorch at equal AP; CUDA: TensorRT if installed) | none | onnx | openvino | engine (falls back to PyTorch).
PERSON_MODEL_CPU=yolo11s.pt
PERSON_MODEL_GPU=yolo11m.pt
PERSON_CONF=0.1
PERSON_IOU=0.6
DETECTOR_EXPORT=auto
FIRE_MODEL_PATH=fire-smoke.pt
FACE_MODEL_PATH=face11n.pt
EMOTION_MODEL_PATH=enet_b0_8_best_afew.onnx
REID_MODEL=osnet_ain_x1_0
REID_WEIGHTS_PATH=osnet_ain_x1_0_msmt17.pth
# Re-ID: tracklet (mean of best 5 crops) joins an identity at >= T_MATCH; it is added as a new view at >= T_UPDATE.
# Thresholds from the CAVIAR open-set study (osnet_ain_x1_0): 0.55 merged 95% of new people into old ids.
REID_T_MATCH=0.75
REID_T_UPDATE=0.85
REID_SIMILARITY_THRESHOLD=0.75
REID_EMBEDDINGS_PER_ID=8
REID_MIN_CROP_HEIGHT=128
# Camera topology JSON (links saved via /api/reid/topology take precedence), e.g.
# [{"from":1,"to":2,"min_s":2,"max_s":60,"bidirectional":true},{"from":2,"to":3,"overlapping":true,"max_s":5}]
REID_CAMERA_TOPOLOGY=

# --- Pipeline / Cost Controls ---
PROCESSING_FPS=6
MAX_CAMERAS=8
FRAME_BUFFER_SIZE=2
DEFAULT_SKIP_FRAMES=0
MAX_REID_DETECTIONS_PER_FRAME=8
ALLOW_MOCK_AI=false
FIRE_INTERVAL_FRAMES=10
PRODUCT_INTERVAL_S=2.0
MEMORY_PRESSURE_PCT=90
EMOTION_ANALYTICS_INTERVAL_FRAMES=12
EMOTION_MIN_FACE_PX=40
EMOTION_MAX_FACES_PER_FRAME=8
EMOTION_THREADS=2
# Age band / gender (FairFace ResNet-34 ONNX, made by scripts/download_default_weights.py)
DEMOGRAPHICS_MODEL_PATH=fairface_res34.onnx
DEMOGRAPHICS_MIN_FACE_SAMPLES=2
DEMOGRAPHICS_MAX_SAMPLES_PER_VISIT=10
DEMOGRAPHICS_MIN_VISITS=20
CALLBACK_TIMEOUT_MS=750

# --- Footage Upload Safety ---
MAX_UPLOAD_MB=512

# Keep CPU libraries from oversubscribing small cloud/edge boxes.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1

# --- Plugins / Integrations ---
# Trusted Python modules loaded by app.plugins.PluginManager.
# Example: ENABLED_PLUGINS=["my_company.loss_prevention","my_company.pos_bridge"]
ENABLED_PLUGINS=[]
PLUGIN_REQUIRE_EXPLICIT_ENABLE=true

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- App ---
APP_NAME=OmniTrack AI
APP_VERSION=1.0.0
DEBUG=false

# IANA zone used for "today" and hour-of-day analytics (e.g. Asia/Karachi)
STORE_TIMEZONE=UTC
