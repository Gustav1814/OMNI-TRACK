# ============================================================
# OmniTrack AI — Environment Configuration
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://omnitrack:omnitrack_secret@localhost:5432/omnitrack_db

# --- JWT ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AES-256 Encryption ---
AES_SECRET_KEY=0123456789abcdef0123456789abcdef

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AI Models ---
# Weights are gitignored; run: python scripts/download_default_weights.py
MODEL_WEIGHTS_DIR=model_weight
DEFAULT_YOLO_MODEL=yolo11n.pt
YOLO_MODEL=yolo11n.pt
YOLO_MODEL_PATH=yolo11n.pt
YOLO_CONFIDENCE=0.5
# Classes to detect AND track. "all" = every class the model knows;
# or a comma-separated list of class ids, e.g. "0,2,5,7" = person,car,bus,truck;
# "0" restores person-only. Person analytics (Re-ID, crowd, shelf, checkout)
# always filter back down to people regardless of this value.
DETECTION_CLASSES=all
YOLO_NMS_THRESHOLD=0.45
FIRE_MODEL_PATH=fire-smoke.pt
# Fire detection runs on every camera, whatever the job's activity. The shipped
# model false-positives on ordinary footage at 0.4 — raise this, or turn it off.
FIRE_CONFIDENCE=0.4
ENABLE_FIRE_DETECTION=true
REID_MODEL_NAME=osnet_x0_25
# Re-ID tuning: face often not visible / same height and clothing
REID_SIMILARITY_THRESHOLD=0.6
REID_EMBEDDINGS_PER_ID=5
MAX_CAMERAS=4
RUNTIME_PROFILE=laptop
TRACKER_DEFAULT=botsort.yaml
TRACKER_REID=false
REID_BACKEND=torchreid
REID_WEIGHTS=
ENABLE_SAM2=false
SAM2_WEIGHTS=sam2_b.pt
DECODE_IMGSZ=480
EVENT_BUS_BACKEND=redis
# pgvector persists and is what the proposal specifies; faiss is in-memory only
VECTOR_STORE_BACKEND=pgvector
ENABLE_MEDIAPIPE=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=omnitrack_embeddings
MEMORY_GUARD_MB=0
STORAGE_FREE_MIN_MB=1024
FOOTAGE_RETENTION_GB=20

# --- Emotion recognition (DeepFace) ---
ENABLE_EMOTION=true
# DeepFace costs ~0.2s/frame, so analyse every Nth tick and reuse the last result
EMOTION_EVERY_N_TICKS=15
# ssd | opencv | mtcnn | retinaface
# ssd is fastest but returns no eye landmarks, and faces without them are
# dropped as false positives — it yields zero samples. Use mtcnn.
EMOTION_DETECTOR_BACKEND=mtcnn

# --- Jobs ---
MAX_JOBS=2
ROI_DWELL_ALERT_SECONDS=30
JOB_FLUSH_INTERVAL_S=5

# --- Job artifacts on disk (snapshots + annotated clips) ---
ARTIFACTS_DIR=shared/ais1
ARTIFACT_SNAPSHOTS=true
ARTIFACT_CLIPS=true
ARTIFACT_SEGMENT_FRAMES=150
ARTIFACT_SNAPSHOT_DEDUP_S=1.0
ARTIFACT_QUOTA_MB=2048

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- App ---
APP_NAME=OmniTrack AI
APP_VERSION=1.0.0
DEBUG=true
