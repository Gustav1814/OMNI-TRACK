# ============================================================
# OmniTrack AI — Environment Configuration
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://omnitrack:omnitrack_secret@localhost:5432/omnitrack_db
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_RUN_MIGRATIONS_ON_STARTUP=true
DB_RUN_ANALYZE_ON_STARTUP=true
DB_RETENTION_ON_STARTUP=true
DB_CREATE_FUTURE_PARTITIONS_ON_STARTUP=true
DB_PARTITION_MONTHS_AHEAD=3
DETECTION_RETENTION_DAYS=30
EMBEDDING_RETENTION_DAYS=90
ANALYTICS_RETENTION_DAYS=365
REID_GALLERY_WARM_LIMIT=2000
DB_STARTUP_MAX_RETRIES=30
DB_STARTUP_RETRY_SECONDS=2
REDIS_STARTUP_MAX_RETRIES=15
REQUIRE_DATABASE=true
REQUIRE_REDIS=true

# --- JWT ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FIRST_USER_ADMIN=true

# --- AES-256 Encryption ---
AES_SECRET_KEY=0123456789abcdef0123456789abcdef

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AI Models ---
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.5
YOLO_NMS_THRESHOLD=0.45
FIRE_MODEL_PATH=fire_smoke.pt
REID_MODEL_NAME=osnet_x1_0
# Re-ID tuning: face often not visible / same height and clothing
REID_SIMILARITY_THRESHOLD=0.6
REID_EMBEDDINGS_PER_ID=8
REID_RECENT_MATCH_THRESHOLD=0.48
REID_RECENT_MEMORY_SECONDS=20
REID_STRONG_SWITCH_MARGIN=0.14
REID_MIN_CROP_HEIGHT=64

# --- Pipeline / Cost Controls ---
PROCESSING_FPS=6
MAX_CAMERAS=8
FRAME_BUFFER_SIZE=2
DEFAULT_SKIP_FRAMES=2
PIPELINE_RESULT_QUEUE_MAXSIZE=256
INFERENCE_BATCH_SIZE=2
MAX_CPU_WORKERS=2
MAX_PARALLEL_CAMERA_PROCESSORS=2
MAX_REID_DETECTIONS_PER_FRAME=8
HEAVY_ANALYTICS_INTERVAL=3
ENABLE_ADAPTIVE_MODEL_GATING=true
ALLOW_MOCK_AI=false
REID_INTERVAL_FRAMES=5
FIRE_ACTIVE_INTERVAL_FRAMES=12
FIRE_IDLE_INTERVAL_FRAMES=45
SHELF_ANALYTICS_INTERVAL_FRAMES=3
EMOTION_ANALYTICS_INTERVAL_FRAMES=12
CHECKOUT_ANALYTICS_INTERVAL_FRAMES=3
CALLBACK_TIMEOUT_MS=750

# --- Footage Upload Safety ---
MAX_UPLOAD_MB=512

# Keep CPU libraries from oversubscribing small cloud/edge boxes.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1

# --- Plugins / Integrations ---
# Trusted Python modules loaded by app.plugins.PluginManager.
# Example: ENABLED_PLUGINS=["my_company.loss_prevention","my_company.pos_bridge"]
ENABLED_PLUGINS=[]
PLUGIN_REQUIRE_EXPLICIT_ENABLE=true

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- App ---
APP_NAME=OmniTrack AI
APP_VERSION=1.0.0
DEBUG=true
